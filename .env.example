# Plantilla de configuracion para otra PC. No contiene valores de .env.local.
# Copiar a .env.local y completar con acceso autorizado antes de iniciar servicios.
# Los valores vacios y CHANGE_ME son marcadores, no una configuracion operativa.
# Nunca versionar .env.local, credenciales, claves, archivos de firmantes o datos.

# Entorno privado: configurar local, preview o test segun el aislamiento real.
# CHANGE_ME impide considerar esta plantilla un entorno privado ya autorizado.
TRUSTLEAF_ENV=CHANGE_ME

# Base de datos: dejar SIN DEFINIR hasta verificar una rama Neon de desarrollo.
# TRUSTLEAF_DATABASE_URL tiene prioridad incluso si su valor es una cadena vacia:
# definirla vacia bloquea el fallback a DATABASE_URL. Por eso se deja comentada.
# La seleccion es TRUSTLEAF_DATABASE_URL, despues DATABASE_URL; POSTGRES_URL
# solo se considera si TRUSTLEAF_ENV no esta definido. No usar produccion local.
# El worker y algunos scripts leen DATABASE_URL directamente: al configurarlos,
# verificar que todas las variables definidas apunten a la misma rama autorizada.
# TRUSTLEAF_DB_HOST debe coincidir exactamente con el hostname de esa conexion.
# No descomentar URL vacias ni completar una conexion copiandola desde Vercel.
# TRUSTLEAF_DATABASE_URL=
# DATABASE_URL=
# POSTGRES_URL=
# TRUSTLEAF_DB_HOST=
# PROD_DB_HOST_GUARD=

# Seguridad: exigir autenticacion; mantener escrituras, demos y migraciones apagadas.
TRUSTLEAF_REQUIRE_AUTH=true
TRUSTLEAF_PRIVATE_WRITES_ENABLED=false
TRUSTLEAF_PRIVATE_PORTAL_ENABLED=false
TRUSTLEAF_CLINICAL_WEB_ENABLED=false
TRUSTLEAF_CLINICAL_TESTNET_WRITES=false
TRUSTLEAF_CLINICAL_MIGRATION=false
TRUSTLEAF_CLINICAL_WEB_MIGRATION=false
TRUSTLEAF_CLINICAL_DB_TEST=false
TRUSTLEAF_ENABLE_TESTNET_DEMO_MINT=false
TRUSTLEAF_WAITLIST_ENABLED=false
TRUSTLEAF_PRIVY_SIGNING_CHECK=false
MCP_LIVE_ENABLED=false
NEXT_PUBLIC_PASSKEY_ENABLED=false
# No definir excepciones temporales de creacion ni de demostraciones de pacientes.
# Su mera presencia, aunque el valor este vacio, cambia la politica de operaciones.

# Privy: recuperar identificadores y secreto de la aplicacion correcta por canal seguro.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
ADMIN_EMAILS=
WAITLIST_ADMIN_TOKEN=
JWT_SECRET=

# Cifrado e identidad: claves de servidor; jamas agregar prefijo NEXT_PUBLIC_.
# DATA_KEY requiere 64 caracteres hexadecimales. CHANGE_ME es invalido a proposito:
# sustituirlo antes de usar datos; dejarlo vacio permite un fallback sin cifrado legacy.
TRUSTLEAF_DATA_KEY=CHANGE_ME
TRUSTLEAF_RUT_PEPPER=
# KEYRING es un objeto JSON {keyId: claveHexDe64Caracteres}; ACTIVE_KEY_ID debe existir.
# Recuperar las claves anteriores para leer datos cifrados; generar otras no los recupera.
TRUSTLEAF_CLINICAL_KEYRING=
TRUSTLEAF_CLINICAL_ACTIVE_KEY_ID=

# Stellar: configurar testnet y su RPC; comprobar IDs con la evidencia del proyecto.
# Los identificadores publicos tampoco se trasladan desde el entorno de esta PC.
NEXT_PUBLIC_STELLAR_NETWORK=
NEXT_PUBLIC_SOROBAN_RPC_URL=
NEXT_PUBLIC_DOCTOR_REGISTRY_ID=
NEXT_PUBLIC_PRESCRIPTION_ID=
NEXT_PUBLIC_DEMO_CLINICAL_RECORD_ID=
NEXT_PUBLIC_WALLET_WASM_HASH=
NEXT_PUBLIC_DEMO_DOCTOR_WALLET=
NEXT_PUBLIC_DEMO_PATIENT_WALLET=
DOCTOR_REGISTRY_PRIVATE_CONTRACT_ID=
PRESCRIPTION_PRIVATE_CONTRACT_ID=
CLINICAL_HISTORY_PRIVATE_CONTRACT_ID=
CLINICAL_RECORD_WASM_HASH=
DOCUMENT_SOULBOUND_ID=
SANDBOX_CLINICAL_RECORD_ID=
# Proveedor clinico opcional: dejar indefinido conserva el default sdf del codigo.
# TRUSTLEAF_CLINICAL_RPC_PROVIDER=

# Firmantes: recuperar por canal seguro. Un alias no transporta la clave privada.
# STELLAR_CONFIG_DIR debe ser una ruta local de la nueva PC, fuera del repositorio.
STELLAR_CONFIG_DIR=
DOCTOR_REGISTRY_ADMIN_ALIAS=
DOCTOR_REGISTRY_ADMIN_PUBLIC_KEY=
BOOKING_AUTHORITY_ALIAS=
BOOKING_AUTHORITY_PUBLIC_KEY=
RELAYER_SECRET=
DEMO_DOCTOR_SECRET=
DEMO_PATIENT_SECRET=
SANDBOX_OWNER_SECRET=
SANDBOX_CENTER_SECRET=
TRUSTLEAF_DEMO_DOCTOR_EMAIL=
TRUSTLEAF_DEMO_DOCTOR_WALLET=
TRUSTLEAF_DEMO_PATIENT_WALLET=

# Servicios opcionales. Credenciales vacias mantienen estas integraciones sin configurar.
NEXT_PUBLIC_APP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
ANTHROPIC_API_KEY=
PHARMACY_API_KEYS=
PHARMACY_PIN=
PHARMACY_RUT_INDEX=
PHARMACY_RELAYER_SECRET=
DISPENSARY_REGISTRY_ID=
DISPENSE_RECORD_ID=

# Ajustes opcionales: descomentar solo con valores validos y contexto verificado.
# Dejarlos indefinidos conserva los defaults del codigo; vacio no equivale a indefinido.
# NEXT_PUBLIC_RX_VALIDITY_DAYS=
# MCP_RATE_LIMIT_PER_MIN=
# MCP_RATE_LIMIT_HEAVY_PER_MIN=
# TEST_BASE_URL=
# SMOKE_BASE_URL=
# NODE_ENV, VERCEL y VERCEL_ENV los establece el runtime/plataforma: no copiarlos de otra PC.
